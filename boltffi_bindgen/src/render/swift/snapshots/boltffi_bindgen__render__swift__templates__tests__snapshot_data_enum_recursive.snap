assertion_line: 980
expression: "render_enum(&e, \"\")"
---
public enum Tree: Hashable, Equatable, Sendable {
    case leaf(Int32)
    indirect case node(left: Tree, right: Tree)

}

extension Tree: WireCodable {
    @inlinable static func decode(from reader: inout WireReader) -> Tree {
        let tag = reader.readI32()
        switch tag {
        case 0:
            return .leaf(reader.readI32())
        case 1:
            return .node(left: reader.readI32(), right: reader.readI32())
        default:
            fatalError("Invalid Tree tag: \(tag)")
        }
    }

    @inlinable func encode(to writer: inout WireWriter) {
        switch self {
        case let .leaf(value):
            writer.writeI32(0)
            writer.writeI32(value)
        case let .node(left, right):
            writer.writeI32(1)
            writer.writeI32(left)
            writer.writeI32(right)
        }
    }
}
