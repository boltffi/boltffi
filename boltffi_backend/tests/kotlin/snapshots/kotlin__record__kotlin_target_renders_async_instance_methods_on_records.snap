data class Label(
    val text: String
) {
    internal fun wireSize(): Int {
        return 4 + Utf8Codec.maxBytes(this.text)
    }

    internal fun writeTo(writer: WireWriter) {
        writer.writeString(this.text)
    }

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): Label {
            return Label(
                reader.readString()
            )
        }

        internal fun fromByteArray(bytes: ByteArray): Label {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }

    suspend fun measure(): UInt {
        return boltffiCallAsync(
            createFuture = {
                val __boltffi_label_wire = WireWriterPool.acquire(this.wireSize())
                val __boltffi_label_writer = __boltffi_label_wire.writer
                this.writeTo(__boltffi_label_writer)
                try {
                    Native.boltffi_method_record_4demo5Label7measure(__boltffi_label_wire.directBuffer(), __boltffi_label_wire.size())
                } finally {
                    __boltffi_label_wire.close()
                }
            },
            poll = { future, contHandle -> Native.boltffi_async_method_record_4demo5Label7measure_poll(future, contHandle) },
            complete = { future ->
                Native.boltffi_async_method_record_4demo5Label7measure_complete(future).toUInt()
