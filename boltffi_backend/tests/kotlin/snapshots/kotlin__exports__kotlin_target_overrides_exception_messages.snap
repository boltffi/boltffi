data class RecordError(
    override val message: String
) : Exception(message) {
    internal fun wireSize(): Int {
        return 4 + Utf8Codec.maxBytes(this.message)
    }

    internal fun writeTo(writer: WireWriter) {
        writer.writeString(this.message)
    }

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): RecordError {
            return RecordError(
                reader.readString()
            )
        }

        internal fun fromByteArray(bytes: ByteArray): RecordError {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}


