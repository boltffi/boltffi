sealed class ServiceError : Exception() {
    internal abstract fun wireSize(): Int

    internal abstract fun writeTo(writer: WireWriter)

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }


    data class Failed(
        override val message: String
    ) : ServiceError() {
        internal override fun wireSize(): Int {
            return 4 + 4 + Utf8Codec.maxBytes(this.message)
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(0.toUInt())
            writer.writeString(this.message)
        }
    }
    data class Optional(
        override val message: String?
    ) : ServiceError() {
        internal override fun wireSize(): Int {
            return 4 + 1 + (this.message?.let { __boltffi_value_0 -> 4 + Utf8Codec.maxBytes(__boltffi_value_0) } ?: 0)
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(1.toUInt())
            writer.writeOptionalValue(this.message, { writer, __boltffi_value_0 -> writer.writeString(__boltffi_value_0) })
        }
    }
    data class Detailed(
        val code: UInt,
        override val message: String
    ) : ServiceError() {
        internal override fun wireSize(): Int {
            return 4 + 4 + 4 + Utf8Codec.maxBytes(this.message)
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(2.toUInt())
            writer.writeU32(this.code)
            writer.writeString(this.message)
        }
    }
    object Unknown : ServiceError() {
        internal override fun wireSize(): Int {
            return 4
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(3.toUInt())
        }
    }
    data class Text(
        val field0: String
    ) : ServiceError() {
        internal override fun wireSize(): Int {
            return 4 + 4 + Utf8Codec.maxBytes(this.field0)
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(4.toUInt())
            writer.writeString(this.field0)
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): ServiceError {
            val tag = reader.readU32()
            return when (tag) {
                0.toUInt() -> Failed(reader.readString())
                1.toUInt() -> Optional(reader.readOptionalValue({ reader -> reader.readString() }))
                2.toUInt() -> Detailed(reader.readU32(), reader.readString())
                3.toUInt() -> Unknown
                4.toUInt() -> Text(reader.readString())
                else -> throw IllegalArgumentException("unknown ServiceError tag: $tag")
            }
        }

        internal fun fromByteArray(bytes: ByteArray): ServiceError {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}


