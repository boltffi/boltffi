        writer.writeOptionalValue(this.maybeNamed, { writer, __boltffi_value_0 -> writer.writeMap(__boltffi_value_0, { writer, __boltffi_value_1 -> writer.writeString(__boltffi_value_1) }, { writer, __boltffi_value_2 -> writer.writeSequence(__boltffi_value_2, __boltffi_value_2.size, { writer, __boltffi_value_3 -> writer.writeBytes(__boltffi_value_3) }) }) })
    }

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
