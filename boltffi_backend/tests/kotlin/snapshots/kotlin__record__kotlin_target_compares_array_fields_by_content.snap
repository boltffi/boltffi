    internal fun writeTo(writer: WireWriter) {
        writer.writeOptionalValue(this.maybeChunks, { writer, __boltffi_value_0 -> writer.writeSequence(__boltffi_value_0, __boltffi_value_0.size, { writer, __boltffi_value_1 -> writer.writeBytes(__boltffi_value_1) }) })
        writer.writeSequence(this.pages, this.pages.size, { writer, __boltffi_value_0 -> writer.writeSequence(__boltffi_value_0, __boltffi_value_0.size, { writer, __boltffi_value_1 -> writer.writeBytes(__boltffi_value_1) }) })
        writer.writeSequence(this.sparse, this.sparse.size, { writer, __boltffi_value_0 -> writer.writeOptionalValue(__boltffi_value_0, { writer, __boltffi_value_1 -> writer.writeSequence(__boltffi_value_1, __boltffi_value_1.size, { writer, __boltffi_value_2 -> writer.writeBytes(__boltffi_value_2) }) }) })
