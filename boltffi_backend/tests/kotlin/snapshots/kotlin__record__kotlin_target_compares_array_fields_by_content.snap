        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): Label {
            return Label(
                reader.readString()
            )
        }

        internal fun fromByteArray(bytes: ByteArray): Label {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}


data class BlobError(
    override val message: String,
    val payload: ByteArray
) : Exception(message) {
    internal fun wireSize(): Int {
        return 4 + Utf8Codec.maxBytes(this.message) + 4 + this.payload.size
    }

    internal fun writeTo(writer: WireWriter) {
        writer.writeString(this.message)
        writer.writeBytes(this.payload)
    }

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): BlobError {
            return BlobError(
                reader.readString(),
                reader.readBytes()
            )
        }

        internal fun fromByteArray(bytes: ByteArray): BlobError {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }

    override fun equals(other: kotlin.Any?): kotlin.Boolean {
        if (this === other) return true
        if (other !is BlobError) return false
        return this.message == other.message &&
            this.payload.contentEquals(other.payload)
    }

    override fun hashCode(): kotlin.Int {
        var result = this.message.hashCode()
        result = 31 * result + this.payload.contentHashCode()
        return result
    }
}


sealed class Frame {
    internal abstract fun wireSize(): Int

    internal abstract fun writeTo(writer: WireWriter)

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }


    object Empty : Frame() {
        internal override fun wireSize(): Int {
            return 4
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(0u)
        }
    }
    data class Data(
        val payload: ByteArray
    ) : Frame() {
        internal override fun wireSize(): Int {
            return 4 + 4 + this.payload.size
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(1u)
            writer.writeBytes(this.payload)
        }

        override fun equals(other: kotlin.Any?): kotlin.Boolean {
            if (this === other) return true
            if (other !is Data) return false
            return this.payload.contentEquals(other.payload)
