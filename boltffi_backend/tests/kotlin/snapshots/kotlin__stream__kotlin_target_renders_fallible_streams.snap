    @JvmStatic external fun boltffi_stream_demo_jobs_ticks_wait(subscription: Long, timeout_milliseconds: Int): Int
    @JvmStatic external fun boltffi_stream_demo_jobs_ticks_poll(subscription: Long, callback_data: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_ticks_unsubscribe(subscription: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_ticks_free(subscription: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_ticks_take_error(subscription: Long): ByteArray?

    @JvmStatic fun boltffiFutureContinuationCallback(handle: Long, pollResult: Byte) {
        BoltFfiAsync.resume(handle, pollResult)
    }
}


sealed class JobError : Exception() {
    internal abstract fun wireSize(): Int

    internal abstract fun writeTo(writer: WireWriter)

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }


    data class Refused(
        val code: UInt
    ) : JobError() {
        internal override fun wireSize(): Int {
            return 4 + 4
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(0.toUInt())
            writer.writeU32(this.code)
        }
    }
    object Lost : JobError() {
        internal override fun wireSize(): Int {
            return 4
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(1.toUInt())
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): JobError {
            val tag = reader.readU32()
            return when (tag) {
                0.toUInt() -> Refused(reader.readU32())
                1.toUInt() -> Lost
                else -> throw IllegalArgumentException("unknown JobError tag: $tag")
            }
        }

        internal fun fromByteArray(bytes: ByteArray): JobError {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}

class Jobs internal constructor(internal val handle: Long) : AutoCloseable {
    private val __boltffi_closed = java.util.concurrent.atomic.AtomicBoolean(false)

    override fun close() {
        if (__boltffi_closed.compareAndSet(false, true)) {
            Native.boltffi_release_class_demo_jobs(handle)
        }
    }

    internal fun __boltffiTakeHandle(): Long {
        check(__boltffi_closed.compareAndSet(false, true)) { "Jobs is closed" }
        return handle
    }

    internal fun boltffiHandle(): Long {
        check(!__boltffi_closed.get()) { "Jobs is closed" }
        return handle
    }
}

fun Jobs.lines(): kotlinx.coroutines.flow.Flow<String> = kotlinx.coroutines.flow.callbackFlow {
    val subscription = Native.boltffi_stream_demo_jobs_lines_subscribe(boltffiHandle())
    if (subscription == 0L) {
        close()
        return@callbackFlow
    }
    val context = BoltFfiStreamContext(
        scope = this,
        subscription = subscription,
        batchSize = 16L,
        popBatch = Native::boltffi_stream_demo_jobs_lines_pop_batch,
        poll = Native::boltffi_stream_demo_jobs_lines_poll,
        unsubscribe = Native::boltffi_stream_demo_jobs_lines_unsubscribe,
        free = Native::boltffi_stream_demo_jobs_lines_free,
        processItems = { bytes ->
            val reader = WireReader(bytes)
            val count = reader.readU32().toInt()
            val items = List(count) { reader.readString() }
            items.forEach { item ->
                send(item)
            }
        },
        finish = { close(it) },
        takeFailure = { handle ->
            val bytes = Native.boltffi_stream_demo_jobs_lines_take_error(handle)
            if (bytes == null || bytes.isEmpty()) null else {
                val __boltffi_error_reader = WireReader(bytes)
                FfiException(__boltffi_error_reader.readString())
            }
        }
    )
    context.start()
    awaitClose { context.requestTermination() }
}

fun Jobs.progress(): ProgressSubscription =
    ProgressSubscription(
        handle = Native.boltffi_stream_demo_jobs_progress_subscribe(boltffiHandle()),
        popBatch = Native::boltffi_stream_demo_jobs_progress_pop_batch,
        wait = Native::boltffi_stream_demo_jobs_progress_wait,
        unsubscribe = Native::boltffi_stream_demo_jobs_progress_unsubscribe,
        free = Native::boltffi_stream_demo_jobs_progress_free,
        takeFailure = { handle ->
            val bytes = Native.boltffi_stream_demo_jobs_progress_take_error(handle)
            if (bytes == null || bytes.isEmpty()) null else {
                val __boltffi_error_reader = WireReader(bytes)
                JobError.fromReader(__boltffi_error_reader)
            }
        }
    )

class ProgressSubscription(
    private val handle: Long,
    private val popBatch: (Long, Long) -> ByteArray?,
    private val wait: (Long, Int) -> Int,
    private val unsubscribe: (Long) -> Unit,
    private val free: (Long) -> Unit,
    private val takeFailure: (Long) -> Throwable?
) : AutoCloseable {
    private val closed = java.util.concurrent.atomic.AtomicBoolean(false)
    @Volatile private var failure: Throwable? = null

    override fun close() {
        if (!closed.compareAndSet(false, true)) return
        if (handle == 0L) return
        free(handle)
    }

    fun popBatch(maxCount: Long = 16L): List<Int> {
        if (handle == 0L) return emptyList()
        // closed before this pop, so nothing can arrive after it: an empty pop is final
        val ended = failure == null && wait(handle, 0) < 0
        val bytes = popBatch(handle, maxCount)
            ?: throw IllegalStateException("BoltFFI stream pop_batch returned null")
        if (bytes.isEmpty()) {
            if (ended) failure = takeFailure(handle)
            failure?.let { throw it }
            return emptyList()
        }
        val items = DirectVectorCodec.readIntArray(bytes).toList()
        return items
    }

    fun wait(timeout: Int): Int {
        if (handle == 0L) return -1
        return wait(handle, timeout)
    }

    fun unsubscribe() {
        if (handle == 0L) return
        unsubscribe(handle)
    }
}

fun Jobs.ticks(onError: (Throwable) -> Unit, callback: (Int) -> Unit): TicksCancellable {
    val subscription = Native.boltffi_stream_demo_jobs_ticks_subscribe(boltffiHandle())
    if (subscription == 0L) return TicksCancellable {}
    val context = BoltFfiStreamContext(
        scope = boltffiCallbackScope,
        subscription = subscription,
        batchSize = 16L,
        popBatch = Native::boltffi_stream_demo_jobs_ticks_pop_batch,
        poll = Native::boltffi_stream_demo_jobs_ticks_poll,
        unsubscribe = Native::boltffi_stream_demo_jobs_ticks_unsubscribe,
        free = Native::boltffi_stream_demo_jobs_ticks_free,
        processItems = { bytes ->
            val items = DirectVectorCodec.readIntArray(bytes).toList()
            items.forEach { item ->
                callback(item)
            }
        },
        finish = { failure -> failure?.let(onError) },
        takeFailure = { handle ->
            val bytes = Native.boltffi_stream_demo_jobs_ticks_take_error(handle)
            if (bytes == null || bytes.isEmpty()) null else {
                val __boltffi_error_reader = WireReader(bytes)
                FfiException(__boltffi_error_reader.readString())
            }
        }
    )
    context.start()
    return TicksCancellable { context.requestTermination() }
}

class TicksCancellable(
    private val onCancel: () -> Unit = {}
) : AutoCloseable {
    private val cancelled = java.util.concurrent.atomic.AtomicBoolean(false)

    fun cancel() {
        if (!cancelled.compareAndSet(false, true)) return
        onCancel()
    }

    override fun close() {
        cancel()
    }
}
