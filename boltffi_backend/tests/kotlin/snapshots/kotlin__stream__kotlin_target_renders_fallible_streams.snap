package com.boltffi.demo

import kotlinx.coroutines.launch
import kotlinx.coroutines.channels.awaitClose
@Suppress("FunctionName")
private object Native {
    @JvmStatic external fun boltffi_release_class_demo_jobs(handle: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_lines_subscribe(`receiver`: Long): Long
    @JvmStatic external fun boltffi_stream_demo_jobs_lines_pop_batch(subscription: Long, max_count: Long): ByteArray?
    @JvmStatic external fun boltffi_stream_demo_jobs_lines_wait(subscription: Long, timeout_milliseconds: Int): Int
    @JvmStatic external fun boltffi_stream_demo_jobs_lines_poll(subscription: Long, callback_data: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_lines_unsubscribe(subscription: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_lines_free(subscription: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_lines_take_error(subscription: Long): ByteArray?
    @JvmStatic external fun boltffi_stream_demo_jobs_progress_subscribe(`receiver`: Long): Long
    @JvmStatic external fun boltffi_stream_demo_jobs_progress_pop_batch(subscription: Long, maxCount: Long): ByteArray?
    @JvmStatic external fun boltffi_stream_demo_jobs_progress_wait(subscription: Long, timeout_milliseconds: Int): Int
    @JvmStatic external fun boltffi_stream_demo_jobs_progress_poll(subscription: Long, callback_data: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_progress_unsubscribe(subscription: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_progress_free(subscription: Long): Unit
    @JvmStatic external fun boltffi_stream_demo_jobs_progress_take_error(subscription: Long): ByteArray?
    @JvmStatic external fun boltffi_stream_demo_jobs_ticks_subscribe(`receiver`: Long): Long
