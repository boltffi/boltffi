    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): CollectionSizes {
            return CollectionSizes(
                reader.readSequence({ reader -> reader.readString() }),
                reader.readSequence({ reader -> State.fromValue(reader.readI32()) }),
