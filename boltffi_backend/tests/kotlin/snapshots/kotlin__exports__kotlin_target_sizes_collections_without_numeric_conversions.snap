}


enum class State(val value: Int) {
    READY(0),
    COMPLETE(1);

    companion object {
        fun fromValue(value: Int): State =
            entries.first { it.value == value }
    }
}


sealed class CollectionEvent {
    internal abstract fun wireSize(): kotlin.Int

    internal abstract fun writeTo(writer: WireWriter)

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }


    data class Int(
        val field0: List<String>
    ) : CollectionEvent() {
        internal override fun wireSize(): kotlin.Int {
            return 4 + 4 + this.field0.sumOf { __boltffi_value_0 -> val __boltffi_size: kotlin.Int = 4 + Utf8Codec.maxBytes(__boltffi_value_0); __boltffi_size }
        }

        internal override fun writeTo(writer: WireWriter) {
            writer.writeU32(0.toUInt())
            writer.writeSequence(this.field0, this.field0.size, { writer, __boltffi_value_0 -> writer.writeString(__boltffi_value_0) })
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): CollectionEvent {
            val tag = reader.readU32()
            return when (tag) {
                0.toUInt() -> Int(reader.readSequence({ reader -> reader.readString() }))
                else -> throw IllegalArgumentException("unknown CollectionEvent tag: $tag")
            }
        }

        internal fun fromByteArray(bytes: ByteArray): CollectionEvent {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}
