package com.boltffi.demo

data class Label(
    val text: String
) {
    internal fun wireSize(): Int {
        return 4 + Utf8Codec.maxBytes(this.text)
    }

    internal fun writeTo(writer: WireWriter) {
        writer.writeString(this.text)
    }

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): Label {
            return Label(
                reader.readString()
            )
        }

        internal fun fromByteArray(bytes: ByteArray): Label {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}


data class CollectionSizes(
