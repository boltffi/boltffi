        return 4 + this.strings.sumOf { __boltffi_value_0 -> val __boltffi_size: kotlin.Int = 4 + Utf8Codec.maxBytes(__boltffi_value_0); __boltffi_size } + 4 + this.states.sumOf { __boltffi_value_0 -> val __boltffi_size: kotlin.Int = 4; __boltffi_size } + 4 + this.nested.sumOf { __boltffi_value_0 -> val __boltffi_size: kotlin.Int = 4 + __boltffi_value_0.sumOf { __boltffi_value_1 -> val __boltffi_size: kotlin.Int = 4 + Utf8Codec.maxBytes(__boltffi_value_1); __boltffi_size }; __boltffi_size } + 4 + this.optional.sumOf { __boltffi_value_0 -> val __boltffi_size: kotlin.Int = 1 + (__boltffi_value_0?.let { __boltffi_value_1 -> 4 + Utf8Codec.maxBytes(__boltffi_value_1) } ?: 0); __boltffi_size } + 4 + this.records.sumOf { __boltffi_value_0 -> val __boltffi_size: kotlin.Int = __boltffi_value_0.wireSize(); __boltffi_size } + 4 + this.numbers.size * 4
    }

    internal fun writeTo(writer: WireWriter) {
        writer.writeSequence(this.strings, this.strings.size, { writer, __boltffi_value_0 -> writer.writeString(__boltffi_value_0) })
        writer.writeSequence(this.states, this.states.size, { writer, __boltffi_value_0 -> writer.writeI32(__boltffi_value_0.value) })
        writer.writeSequence(this.nested, this.nested.size, { writer, __boltffi_value_0 -> writer.writeSequence(__boltffi_value_0, __boltffi_value_0.size, { writer, __boltffi_value_1 -> writer.writeString(__boltffi_value_1) }) })
        writer.writeSequence(this.optional, this.optional.size, { writer, __boltffi_value_0 -> writer.writeOptionalValue(__boltffi_value_0, { writer, __boltffi_value_1 -> writer.writeString(__boltffi_value_1) }) })
        writer.writeSequence(this.records, this.records.size, { writer, __boltffi_value_0 -> __boltffi_value_0.writeTo(writer) })
        writer.writeUIntArray(this.numbers)
