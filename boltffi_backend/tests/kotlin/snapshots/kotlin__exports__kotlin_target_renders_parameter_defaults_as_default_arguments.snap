        return 4 + Utf8Codec.maxBytes(this.email) + 4 + Utf8Codec.maxBytes(this.identifier) + 1 + (this.optionalEmail?.let { __boltffi_value_0 -> 4 + Utf8Codec.maxBytes(__boltffi_value_0) } ?: 0)
