            return FloatDefaults(
                reader.readF32(),
                reader.readF64()
            )
        }

        internal fun fromByteArray(bytes: ByteArray): FloatDefaults {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}


data class ContactDefaults(
    val email: String = "mailto:ada@example.com",
    val identifier: String = "01234567-89ab-cdef-0123-456789abcdef",
    val optionalEmail: String? = null
) {
