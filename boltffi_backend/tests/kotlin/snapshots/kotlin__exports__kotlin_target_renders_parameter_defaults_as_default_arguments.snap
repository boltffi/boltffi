fun interface ClosureI32ToI32 {
    fun invoke(arg0: Int): Int
}

private object ClosureI32ToI32Callbacks {
    private val map = java.util.concurrent.ConcurrentHashMap<Long, ClosureI32ToI32>()
    private val counter = java.util.concurrent.atomic.AtomicLong(1L)

    fun insert(value: ClosureI32ToI32): Long {
        val handle = counter.getAndAdd(2L)
        map[handle] = value
        return handle
    }

    @JvmStatic
    fun free(handle: Long) {
        map.remove(handle)
    }

    @JvmStatic
    fun call(handle: Long, arg0: Int): Int {
        val impl = map[handle] ?: error("ClosureI32ToI32Callbacks: invalid handle $handle")
        return impl.invoke(arg0)
    }
}

