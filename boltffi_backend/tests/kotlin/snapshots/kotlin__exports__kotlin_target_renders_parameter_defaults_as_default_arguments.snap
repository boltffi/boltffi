class Server internal constructor(internal val handle: Long) : AutoCloseable {
    private val __boltffi_closed = java.util.concurrent.atomic.AtomicBoolean(false)

    override fun close() {
        if (__boltffi_closed.compareAndSet(false, true)) {
            Native.boltffi_release_class_demo_server(handle)
        }
    }

    internal fun __boltffiTakeHandle(): Long {
        check(__boltffi_closed.compareAndSet(false, true)) { "Server is closed" }
        return handle
    }

    internal fun boltffiHandle(): Long {
        check(!__boltffi_closed.get()) { "Server is closed" }
        return handle
    }

    constructor(port: UShort = 8080.toUShort()) : this(new(port).handle)

    companion object {
        private fun new(port: UShort): Server {
            return Server(Native.boltffi_init_class_demo_server_new(port.toShort()))
        }
        suspend fun start(port: UShort, first: Handler? = null, second: Handler? = null): Server {
            return boltffiCallAsync(
                createFuture = {
                    Native.boltffi_init_class_demo_server_start(port.toShort(), first?.let { __boltffi_callback -> HandlerBridge.create(__boltffi_callback) } ?: 0L, second?.let { __boltffi_callback -> HandlerBridge.create(__boltffi_callback) } ?: 0L)
                },
                poll = { future, contHandle -> Native.boltffi_async_init_class_demo_server_start_poll(future, contHandle) },
                complete = { future ->
                    Server(Native.boltffi_async_init_class_demo_server_start_complete(future))
                },
                free = { future -> Native.boltffi_async_init_class_demo_server_start_free(future) },
                cancel = { future -> Native.boltffi_async_init_class_demo_server_start_cancel(future) },
            )
        }
    }

    fun port(mapped: Boolean = false): UShort {
        return Native.boltffi_method_class_demo_server_port(this.boltffiHandle(), mapped).toUShort()
    }
}

class DefaultCounter internal constructor(internal val handle: Long) : AutoCloseable {
    private val __boltffi_closed = java.util.concurrent.atomic.AtomicBoolean(false)

    override fun close() {
        if (__boltffi_closed.compareAndSet(false, true)) {
            Native.boltffi_release_class_demo_default_counter(handle)
        }
    }

    internal fun __boltffiTakeHandle(): Long {
        check(__boltffi_closed.compareAndSet(false, true)) { "DefaultCounter is closed" }
        return handle
    }

    internal fun boltffiHandle(): Long {
        check(!__boltffi_closed.get()) { "DefaultCounter is closed" }
        return handle
    }

    constructor(start: Int = 10) : this(new(start).handle)

    constructor(start: Int = 20, offset: Int) : this(withOffset(start, offset).handle)

    companion object {
        fun fromText(value: String = "40"): DefaultCounter {
            val __boltffi_value_wire = WireWriterPool.acquire(4 + Utf8Codec.maxBytes(value))
            val __boltffi_value_writer = __boltffi_value_wire.writer
            __boltffi_value_writer.writeString(value)
            try {
                return DefaultCounter(Native.boltffi_init_class_demo_default_counter_from_text(__boltffi_value_wire.directBuffer(), __boltffi_value_wire.size()))
            } finally {
                __boltffi_value_wire.close()
            }
        }
        private fun new(start: Int): DefaultCounter {
            return DefaultCounter(Native.boltffi_init_class_demo_default_counter_new(start))
        }
        private fun withOffset(start: Int, offset: Int): DefaultCounter {
            return DefaultCounter(Native.boltffi_init_class_demo_default_counter_with_offset(start, offset))
        }
        fun sum(left: Int = 1, right: Int = 2): Int {
            return Native.boltffi_method_class_demo_default_counter_sum(left, right)
        }
    }

    fun offset(step: Int = 1): Int {
        return Native.boltffi_method_class_demo_default_counter_offset(this.boltffiHandle(), step)
    }

    suspend fun asyncOffset(step: Int = 3): Int {
        return boltffiCallAsync(
            createFuture = {
