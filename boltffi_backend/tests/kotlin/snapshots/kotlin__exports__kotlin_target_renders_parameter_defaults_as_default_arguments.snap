        }

        fun tryScaledValue(value: Int = 2): DefaultAmount? {
            val __boltffi_result = Native.boltffi_method_record_demo_default_amount_try_scaled_value(value) ?: throw IllegalStateException("null buffer returned")
            val __boltffi_reader = WireReader(__boltffi_result)
            return __boltffi_reader.readOptionalValue({ __boltffi_reader -> DefaultAmount.fromReader(__boltffi_reader) })
        }
    }

    fun offset(step: Int = 2): Int {
        val __boltffi_receiver = this.toDirectBuffer()
        return Native.boltffi_method_record_demo_default_amount_offset(__boltffi_receiver, step)
    }
}


