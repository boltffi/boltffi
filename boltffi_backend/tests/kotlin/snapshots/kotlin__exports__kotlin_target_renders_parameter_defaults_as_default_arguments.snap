    internal fun writeTo(writer: WireWriter) {
        writer.writeString(this.email)
        writer.writeString(this.identifier)
        writer.writeOptionalValue(this.optionalEmail, { writer, __boltffi_value_0 -> writer.writeString(__boltffi_value_0) })
    }

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): ContactDefaults {
            return ContactDefaults(
                reader.readString(),
                reader.readString(),
                reader.readOptionalValue({ reader -> reader.readString() })
            )
        }

        internal fun fromByteArray(bytes: ByteArray): ContactDefaults {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}


