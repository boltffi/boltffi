fun interface Handler {
    fun process(value: UInt): UInt
}

private object HandlerMap {
    private val map = java.util.concurrent.ConcurrentHashMap<Long, Handler>()
    private val counter = java.util.concurrent.atomic.AtomicLong(1L)

    fun insert(value: Handler): Long {
        val handle = counter.getAndAdd(2L)
        map[handle] = value
        return handle
    }

    fun get(handle: Long): Handler? = map[handle]

    fun remove(handle: Long): Handler? = map.remove(handle)

    fun clone(handle: Long): Long {
        val value = map[handle] ?: return 0L
        return insert(value)
    }
}

object HandlerCallbacks {
    @JvmStatic
    fun free(handle: Long) {
        HandlerMap.remove(handle)
    }

    @JvmStatic
    fun clone(handle: Long): Long {
        return HandlerMap.clone(handle)
    }

    @JvmStatic
    fun process(handle: Long, value: Int): Int {
        val impl = HandlerMap.get(handle) ?: error("HandlerMap: invalid handle $handle")
        return impl.process(value.toUInt()).toInt()
    }
}

object HandlerBridge {
    fun create(value: Handler): Long {
        return HandlerMap.insert(value)
    }
}

