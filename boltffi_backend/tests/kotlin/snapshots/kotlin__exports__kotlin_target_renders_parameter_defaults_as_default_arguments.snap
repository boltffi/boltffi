data class Range(
    val start: Long = Long.MIN_VALUE,
    val end: ULong = 18446744073709551615uL
) {
    internal fun toByteArray(): ByteArray {
        val buffer = java.nio.ByteBuffer
            .allocate(STRUCT_SIZE)
            .order(java.nio.ByteOrder.nativeOrder())
        writeTo(buffer, 0)
        return buffer.array()
    }

    internal fun toDirectBuffer(): java.nio.ByteBuffer {
        val buffer = java.nio.ByteBuffer
            .allocateDirect(STRUCT_SIZE)
            .order(java.nio.ByteOrder.nativeOrder())
        writeTo(buffer, 0)
        return buffer
    }

    internal fun writeTo(buffer: java.nio.ByteBuffer, offset: Int) {
        buffer.putLong(offset, start)
        buffer.putLong(offset + 8, end.toLong())
    }

    companion object {
        internal const val STRUCT_SIZE: Int = 16

        internal fun fromByteArray(bytes: ByteArray): Range {
            require(bytes.size == STRUCT_SIZE)
            val buffer = java.nio.ByteBuffer
                .wrap(bytes)
                .order(java.nio.ByteOrder.nativeOrder())
            return fromBuffer(buffer, 0)
        }

        internal fun fromBuffer(buffer: java.nio.ByteBuffer, offset: Int): Range {
            return Range(
                buffer.getLong(offset),
                buffer.getLong(offset + 8).toULong()
            )
        }
    }
}


data class Quota(
    val limit: UInt? = null
) {
    internal fun wireSize(): Int {
        return 1 + (this.limit?.let { __boltffi_value_0 -> 4 } ?: 0)
    }

    internal fun writeTo(writer: WireWriter) {
        writer.writeOptionalValue(this.limit, { writer, __boltffi_value_0 -> writer.writeU32(__boltffi_value_0) })
    }

    internal fun toByteArray(): ByteArray {
        val buffer = WireWriterPool.acquire(wireSize())
        val writer = buffer.writer
        try {
            writeTo(writer)
            return buffer.bytes()
        } finally {
            buffer.close()
        }
    }

    companion object {
        internal fun fromReader(reader: WireReader): Quota {
            return Quota(
                reader.readOptionalValue({ reader -> reader.readU32() })
            )
        }

        internal fun fromByteArray(bytes: ByteArray): Quota {
            val reader = WireReader(bytes)
            return fromReader(reader)
        }
    }
}


data class FloatDefaults(
