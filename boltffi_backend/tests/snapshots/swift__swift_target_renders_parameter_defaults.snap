    return boltffiAmountBytes.withUnsafeBufferPointer { boltffiAmountBuffer in
        let boltffiResult = boltffi_function_demo_default_amount(boltffiAmountBuffer.baseAddress!, UInt(boltffiAmountBuffer.count))
