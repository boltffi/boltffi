public func greet(
    name: String,
    greeting: String = "world",
    times: UInt32 = 3,
    offset: Int64 = -1,
    shout: Bool = true,
    ratio: Float = 0.5,
    mode: Mode = Mode.slow,
    suffix: String? = nil,
    limit: UInt16? = 7
) -> String {
