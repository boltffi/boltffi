    return boltffiNameBytes.withUnsafeBufferPointer { boltffiNameBuffer in
        let boltffiGreetingBytes = boltffiEncode { boltffiGreetingWriter in boltffiGreetingWriter.writeString(greeting) }
        return boltffiGreetingBytes.withUnsafeBufferPointer { boltffiGreetingBuffer in
            let boltffiSuffixBytes = boltffiEncode { boltffiSuffixWriter in boltffiSuffixWriter.writeOptional(suffix) { boltffiSuffixWriter, boltffiValue0 in boltffiSuffixWriter.writeString(boltffiValue0) } }
            return boltffiSuffixBytes.withUnsafeBufferPointer { boltffiSuffixBuffer in
                let boltffiLimitBytes = boltffiEncode { boltffiLimitWriter in boltffiLimitWriter.writeOptional(limit) { writer, value in writer.writeU16(value) } }
                return boltffiLimitBytes.withUnsafeBufferPointer { boltffiLimitBuffer in
                    let boltffiResult = boltffi_function_demo_greet(
                        boltffiNameBuffer.baseAddress!,
                        UInt(boltffiNameBuffer.count),
                        boltffiGreetingBuffer.baseAddress!,
                        UInt(boltffiGreetingBuffer.count),
                        times,
                        offset,
                        shout,
                        ratio,
                        mode.cValue,
                        boltffiSuffixBuffer.baseAddress!,
                        UInt(boltffiSuffixBuffer.count),
                        boltffiLimitBuffer.baseAddress!,
                        UInt(boltffiLimitBuffer.count)
                    )
                    defer { boltffi_free_buf(boltffiResult) }
                    return boltffiDecodeOwnedBuf(boltffiResult.ptr, Int(boltffiResult.len)) { boltffiReader in boltffiReader.readString() }
