public func formatDefaults(
    name: String,
    greeting: String = "hello",
    enabled: Bool = true,
    ratio: Float = 0.5,
    mode: DefaultMode = DefaultMode.quiet,
    weight: Double? = 1.5,
    handler: DefaultHandler? = nil
) -> String {
    let boltffiNameBytes = boltffiEncode { boltffiNameWriter in boltffiNameWriter.writeString(name) }
    return boltffiNameBytes.withUnsafeBufferPointer { boltffiNameBuffer in
        let boltffiGreetingBytes = boltffiEncode { boltffiGreetingWriter in boltffiGreetingWriter.writeString(greeting) }
        return boltffiGreetingBytes.withUnsafeBufferPointer { boltffiGreetingBuffer in
            let boltffiWeightBytes = boltffiEncode { boltffiWeightWriter in boltffiWeightWriter.writeOptional(weight) { writer, value in writer.writeF64(value) } }
            return boltffiWeightBytes.withUnsafeBufferPointer { boltffiWeightBuffer in
                let boltffiResult = boltffi_function_demo_format_defaults(
                    boltffiNameBuffer.baseAddress!,
                    UInt(boltffiNameBuffer.count),
                    boltffiGreetingBuffer.baseAddress!,
                    UInt(boltffiGreetingBuffer.count),
                    enabled,
                    ratio,
                    mode.cValue,
                    boltffiWeightBuffer.baseAddress!,
                    UInt(boltffiWeightBuffer.count),
                    handler.map { boltffiCallback in DefaultHandlerBridge.create(boltffiCallback) } ?? BoltFFICallbackHandle(handle: 0, vtable: nil)
                )
                defer { boltffi_free_buf(boltffiResult) }
                return boltffiDecodeOwnedBuf(boltffiResult.ptr, Int(boltffiResult.len)) { boltffiReader in boltffiReader.readString() }
            }
        }
    }
}

