public enum JobError: Hashable, Equatable, Sendable, Error {
    case refused(code: UInt32)
    case lost

    @inlinable static func decode(from reader: inout WireReader) -> JobError {
        let tag = reader.readU32()
        switch tag {
        case 0:
            return .refused(code: reader.readU32())
        case 1:
            return .lost
        default:
            fatalError("Invalid JobError tag: \(tag)")
        }
    }

    @inlinable func encode(to writer: inout WireWriter) {
        switch self {
        case let .refused(code):
            writer.writeU32(0)
            writer.writeU32(code)
        case .lost:
            writer.writeU32(1)
        }
    }
}

