        free: @escaping (UInt64) -> Void,
        takeFailure: @escaping (UInt64) -> Swift.Error?
    ) {
        self.handle = handle
        self.readBatch = readBatch
        self.wait = wait
        self.unsubscribeCall = unsubscribe
        self.free = free
        self.takeFailure = takeFailure
