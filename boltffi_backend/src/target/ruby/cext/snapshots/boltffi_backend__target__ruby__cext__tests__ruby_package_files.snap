==> ext/my_lib/extconf.rb
# frozen_string_literal: true

# Generated by BoltFFI. Do not edit.
#
# Builds the extension and links the Rust static library that
# `boltffi pack ruby` puts in this directory. The `.boltffi-link.json` file
# beside the library lists the system libraries the Rust standard library needs.

require "digest"
require "json"
require "mkmf"
require "shellwords"

module BoltFFIExtconf
  ARTIFACT = "my_lib"
  EXTENSION = "my_lib"
  # The kinds that cargo's `rustc-link-search=[KIND=]PATH` accepts.
  LINK_SEARCH_KINDS = %w[native crate dependency framework all].freeze

  class << self
    def configure
      archive = File.join(__dir__, "lib#{ARTIFACT}.a")
      abort("boltffi: no static library for #{EXTENSION}; run boltffi pack ruby") unless File.exist?(archive)

      metadata = link_metadata("#{archive}.boltffi-link.json")
      $LOCAL_LIBS << " #{archive.shellescape}"
      metadata.fetch("native_link_search_paths", []).each do |entry|
        kind, path = entry.split("=", 2)
        kind, path = "all", entry unless path && LINK_SEARCH_KINDS.include?(kind)
        $LDFLAGS << " -L#{path.shellescape}" unless kind == "framework"
        # Only Apple's linker reads -F. GNU ld reads -F as a different option.
        $LDFLAGS << " -F#{path.shellescape}" if %w[framework all].include?(kind) && darwin?
      end
      linked = $LIBS.split
      native = metadata.fetch("native_static_libraries").reject { |flag| flag.start_with?("-l") && linked.include?(flag) }
      $LIBS << " #{native.map(&:shellescape).join(" ")}"
      export_only_entry_point
      create_makefile("#{EXTENSION}/#{EXTENSION}")
    end

    # `boltffi pack ruby` records a digest of the extension source beside the
    # library. A library packed for another source can lack a function that
    # this source calls, and Ruby would crash at the first call.
    def link_metadata(path)
      abort("boltffi: missing link metadata #{path}") unless File.exist?(path)
      metadata = JSON.parse(File.read(path))
      source = Digest::SHA256.file(File.join(__dir__, "#{EXTENSION}.c")).hexdigest
      abort("boltffi: #{path} belongs to other extension sources; run boltffi pack ruby again") unless metadata["source_sha256"] == source
      metadata
    end

    def darwin?
      RbConfig::CONFIG["host_os"].include?("darwin")
    end

    # Ruby loads extensions with RTLD_GLOBAL. Exported Rust symbols could then
    # bind to another extension's copy, so the extension exports only its
    # entry point and, on development Rubies, `ruby_abi_version`.
    def export_only_entry_point
      symbols = ["Init_#{EXTENSION}"]
      symbols << "ruby_abi_version" if have_macro("RUBY_DLN_CHECK_ABI", "ruby.h")
      case RbConfig::CONFIG["host_os"]
      when /darwin/
        symbols.each { |symbol| $DLDFLAGS << " -Wl,-exported_symbol,_#{symbol}" }
      when /linux|bsd/
        version_script = File.join(Dir.pwd, "#{EXTENSION}.map")
        File.write(version_script, "{ global: #{symbols.join("; ")}; local: *; };\n")
        $DLDFLAGS << " -Wl,--version-script=#{version_script.shellescape}"
      end
    end
  end
end

BoltFFIExtconf.configure

==> my-lib.gemspec
# frozen_string_literal: true

# Generated by BoltFFI. Do not edit.
Gem::Specification.new do |spec|
  spec.name = "my-lib"
  spec.version = "1.2.3"
  spec.summary = "Ruby bindings for demo, generated by BoltFFI"
  spec.authors = ["BoltFFI"]
  spec.required_ruby_version = ">= 3.3"
  spec.require_paths = ["lib"]
  spec.extensions = ["ext/my_lib/extconf.rb"]
  stem = "my_lib"
  spec.files = Dir.chdir(__dir__) do
    Dir["lib/#{stem}.rb", "ext/#{stem}/*.{c,h,rb,a}", "ext/#{stem}/*.boltffi-link.json"]
  end
  # The vendored static library runs only on the platform that built it, so
  # the gem names that platform. The tag leaves out the Darwin version. That
  # version names the macOS that built Ruby, and the library does not need it.
  host = Gem::Platform.local
  spec.platform = host.os == "darwin" ? Gem::Platform.new([host.cpu, host.os]) : host
end
