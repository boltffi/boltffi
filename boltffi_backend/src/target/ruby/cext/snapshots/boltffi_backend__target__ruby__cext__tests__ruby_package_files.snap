/* Generated by BoltFFI. Do not edit. */
#include <ruby.h>

#include "boltffi.h"

RUBY_FUNC_EXPORTED void Init_my_lib(void) {
    VALUE boltffi_module = rb_cObject;
    boltffi_module = rb_define_module_under(boltffi_module, "MyLib");
    boltffi_module = rb_define_module_under(boltffi_module, "Native");
}

