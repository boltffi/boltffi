---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DocumentationCorpus } from '../../lib/documentation';

type JsonLdDocument = Record<string, unknown>;

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allDocs = await getCollection('docs');
const corpus = new DocumentationCorpus(allDocs);
const page = corpus.page(entry.id);
const { previous, next } = corpus.neighbors(entry.id);
const prevEntry = previous?.entry;
const nextEntry = next?.entry;
const activeSection = entry.id;
const title = page.title;
const description = page.description;
const siteUrl = Astro.site ?? new URL('https://boltffi.dev');
const canonicalUrl = page.htmlUrl(siteUrl);
const markdownUrl = page.markdownUrl(siteUrl);
const markdownPath = page.markdownPath;
const llmsIndexUrl = new URL('/llms.txt', siteUrl).toString();
const docsIndexUrl = new URL('/docs/overview', siteUrl).toString();
const breadcrumbStructuredData: JsonLdDocument = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Docs',
      item: docsIndexUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: canonicalUrl,
    },
  ],
};
const pageStructuredData: JsonLdDocument = entry.id === 'overview'
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'BoltFFI',
      applicationCategory: 'DeveloperApplication',
      url: canonicalUrl,
      description,
      operatingSystem: 'macOS, Linux, Windows',
      softwareHelp: {
        '@type': 'CreativeWork',
        url: docsIndexUrl,
      },
      programmingLanguage: 'Rust',
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description,
      url: canonicalUrl,
      inLanguage: 'en',
      mainEntityOfPage: canonicalUrl,
      author: {
        '@type': 'Organization',
        name: 'BoltFFI',
      },
      publisher: {
        '@type': 'Organization',
        name: 'BoltFFI',
      },
      isPartOf: {
        '@type': 'CreativeWork',
        name: 'BoltFFI Documentation',
        url: docsIndexUrl,
      },
    };
const structuredData: JsonLdDocument[] = [breadcrumbStructuredData, pageStructuredData];
---

<DocsLayout
  title={title}
  description={description}
  activeSection={activeSection}
  canonicalUrl={canonicalUrl}
  markdownUrl={markdownUrl}
  markdownPath={markdownPath}
  llmsIndexUrl={llmsIndexUrl}
  openGraphType={entry.id === 'overview' ? 'website' : 'article'}
  structuredData={structuredData}
>
  <Content />
  {(prevEntry || nextEntry) && (
    <nav class="mt-16 pt-8 border-t border-border flex justify-between items-center not-prose">
      {prevEntry ? (
        <a href={`/docs/${prevEntry.id}`} class="group flex flex-col items-start gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors">
          <span class="text-xs uppercase tracking-wider">Previous</span>
          <span class="font-medium text-foreground group-hover:text-primary transition-colors">{prevEntry.data.title}</span>
        </a>
      ) : <div />}
      {nextEntry ? (
        <a href={`/docs/${nextEntry.id}`} class="group flex flex-col items-end gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors">
          <span class="text-xs uppercase tracking-wider">Next</span>
          <span class="font-medium text-foreground group-hover:text-primary transition-colors">{nextEntry.data.title}</span>
        </a>
      ) : <div />}
    </nav>
  )}
</DocsLayout>
